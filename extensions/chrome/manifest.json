{
  "manifest_version": 3,
  "name": "SwiftFetch",
  "version": "1.0.0",
  "description": "Capture downloads and YouTube videos with SwiftFetch.",
  "key": "MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEApinnedKeyPlaceholderReplaceOnReleaseKey",
  "permissions": ["nativeMessaging", "contextMenus", "scripting", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*", "*://m.youtube.com/watch*"],
      "js": ["youtube.js"],
      "css": ["youtube.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "SwiftFetch" }
}

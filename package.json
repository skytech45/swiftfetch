{
  "name": "swiftfetch",
  "private": true,
  "version": "0.1.0",
  "description": "SwiftFetch — IDM-class cross-platform download manager (monorepo root)",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspace @swiftfetch/desktop",
    "dev": "npm run dev --workspace @swiftfetch/desktop",
    "format": "prettier --write .",
    "lint": "eslint .",
    "tauri": "npm run tauri --workspace @swiftfetch/desktop",
    "typecheck": "npm run typecheck --workspace @swiftfetch/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^16",
    "prettier": "^3",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}

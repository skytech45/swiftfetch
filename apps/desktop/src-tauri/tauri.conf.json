{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftFetch",
  "version": "0.1.0",
  "identifier": "app.swiftfetch.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SwiftFetch",
        "width": 1024,
        "height": 680,
        "minWidth": 820,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
